# AXI25 — ignore local, machine-specific, and secret files

# OS / editor cruft
.DS_Store
*.swp
*.swo
Thumbs.db

# Obsidian local state (safe to keep the app but not the workspace layout)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
# Obsidian Git local settings (commit template, remote, name) — personal, never shared
.obsidian/plugins/obsidian-git/data.json
.trash/
**/*-debug.log

# Build output (the distributable zip)
dist/

# Python — skill runtimes (axi25-source keeps its OpenRouter key in .env)
__pycache__/
.venv/
.env

# Harness local settings and locks (personal, not shared)
.claude/settings.local.json
.claude/scheduled_tasks.lock
.opencode/local.json

# Secrets — never commit credentials
**/credentials/
*.secret

# Maintainer-only — not part of the shipped vault
AUDIT.md

# Maintainer-only ops notes, never shipped
_ops/
